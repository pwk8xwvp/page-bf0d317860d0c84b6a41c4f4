e-height:1.8;color:var(--mid)}\n.plan--wide{grid-column:1/-1;margin-top:4px}\n.wide-head{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:12px 24px;padding-bottom:16px;border-bottom:2px solid var(--ink)}\n.wide-head .price{margin:0 0 6px}\n.feats--grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 28px;margin-top:0;border-top:0}\n.note{max-width:70ch;margin-top:24px;padding:2px 0 2px 14px;border-left:4px solid var(--accent);font-size:13px;line-height:1.9;color:var(--mid)}\n.steps{padding:0;list-style:none;border-top:2px solid var(--ink);counter-reset:step}\n.steps li{display:grid;grid-template-columns:76px minmax(0,1fr);gap:0 18px;padding:22px 0;border-bottom:1px solid var(--line);counter-increment:step}\n.steps li::before{content:counter(step,decimal-leading-zero);grid-column:1;grid-row:1 / span 2;font-size:clamp(24px,3vw,32px);font-weight:800;line-height:1;letter-spacing:-.02em;color:var(--ink)}\n.steps h3{grid-column:2;grid-row:1;margin-bottom:6px;font-size:17px;font-weight:700}\n.steps p{grid-column:2;grid-row:2;max-width:70ch;font-size:14.5px;line-height:1.85;color:#33332f}\n.tips{margin-top:30px;padding:22px 24px;border:2px solid var(--ink);background:var(--gray-1)}\n.tips h3{margin-bottom:10px;font-size:12px;font-weight:800;letter-spacing:.24em}\n.tips ul{padding-left:18px;font-size:14px;line-height:1.9;color:#2e2e2a}\n.tips li+li{margin-top:6px}\n.faq-group{margin-bottom:clamp(30px,4vw,46px)}\n.faq-group:last-child{margin-bottom:0}\n.faq-group>h3{margin-bottom:22px;padding-bottom:10px;border-bottom:2px solid var(--ink);font-size:11px;font-weight:800;letter-spacing:.26em;color:var(--mid)}\n.qa{margin-bottom:26px}\n.qa:last-child{margin-bottom:0}\n.qst{position:relative;display:flex;align-items:center;gap:12px;width:fit-content;max-width:100%;padding:11px 18px;background:var(--ink);color:#fff}\n.qst::after{content:\"\";position:absolute;left:22px;bottom:-9px;width:0;height:0;border-top:9px solid var(--ink);b